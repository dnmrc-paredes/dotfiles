# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"

# Only draw the bar on one display. Without this SketchyBar mirrors every
# item onto all three screens.
. "$PLUGIN_DIR/bar_display.sh"

# Drop dynamic title items from a previous run (they are recreated by --update)
# Only the per-character rows: /title_.*/ also matched title_spacer and
# title_macos, so every reload deleted the separator and the badge and
# front_app.sh put them back after the now-playing button, flipping the
# order of the icons at the bottom of the bar.
sketchybar --remove '/title_[0-9]+/' 2>/dev/null

##### AeroSpace Workspaces #####
# Keep in sync with persistent-workspaces in aerospace.toml
WORKSPACES=("1" "2" "3" "4" "5" "6")
WORKSPACE_ICON="󰀻"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

# Fully transparent: the bar itself draws nothing, so the wallpaper shows
# through everywhere except the rows that carry a background color.
# margin=10 leaves a 10px gap between the bar and the right screen edge.
# blur_radius=0 on purpose. The bar is fully transparent, so the blur was the
# only thing it drew: a 40px strip down the whole right edge, smeared. With no
# item background there -- the run between the title and the controls at the
# bottom is ~450px of it -- it read as an empty box hanging under the title,
# very obvious on a dark wallpaper. With the blur off the bar paints nothing
# and only the item backgrounds show. Raise it if you want the frosted strip
# back.
sketchybar --bar position=right height=40 blur_radius=0 color=0x00000000 margin=10

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

# associated_display is 1-based and picks the screen an item draws on.
# There is no --display flag in sketchybar 2.24; setting it as a default is
# what makes it stick to items the plugin scripts create later too (the
# per-character title rows, the now-playing button, the badge).
sketchybar --default associated_display="$BAR_DISPLAY"

default=(
  padding_left=5
  padding_right=5
  icon.font="JetBrainsMono Nerd Font:Bold:17.0"
  label.font="JetBrainsMono Nerd Font:Bold:14.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### AeroSpace Workspace Indicators #####
# One item per workspace. Only workspace.1 carries the script; it updates
# every item, so AeroSpace's focus callback can just trigger the event.
# See plugins/workspace.sh

sketchybar --add event aerospace_workspace_change

for ws in "${WORKSPACES[@]}"
do
  workspace=(
    icon="$WORKSPACE_ICON"
    icon.drawing=off
    label="$ws"
    label.color=0xffffffff
    label.font="JetBrainsMono Nerd Font:Bold:18.0"
    # The label spans the full 40px row and centers the digit, so the row
    # background (the highlight) is a complete box across the whole bar
    # rather than a small patch behind the number.
    label.align=center
    label.width=40
    label.padding_left=0
    label.padding_right=0
    # Rows fill their whole slot: padding 0 + background.height 40 keeps the
    # pitch at 40, so the active highlight is a full box with no gaps above
    # or below it, and switching workspaces never shifts the layout.
    padding_left=0
    padding_right=0
    # Solid black container; plugins/workspace.sh inverts this row's colors
    # while its workspace is focused.
    background.color=0xff000000
    background.corner_radius=0
    background.height=40
    background.drawing=on
    click_script="aerospace workspace $ws"
  )

  if [ "$ws" = "${WORKSPACES[0]}" ]; then
    workspace+=(
      script="$PLUGIN_DIR/workspace.sh"
      update_freq=5
    )
  fi

  sketchybar --add item "workspace.$ws" left \
             --set "workspace.$ws" "${workspace[@]}"

  if [ "$ws" = "${WORKSPACES[0]}" ]; then
    sketchybar --subscribe "workspace.$ws" aerospace_workspace_change
  fi
done

##### Top Alignment #####
# Extra top padding on the first row so it lines up with the top edge of the
# application windows (Ghostty top sits at y=42; default first row is y=25).
sketchybar --set workspace.1 padding_left=22

##### Front App #####
# Invisible event anchor: its script maintains the vertical title items
# (title_0, title_1, ...) at the bottom of the bar. See plugins/front_app.sh

# Two subscriptions, and both are needed. front_app_switched covers ordinary
# app switches, but it does NOT fire when the focus lands on a workspace with
# no windows, which left the previous app's title sitting on the bar. The
# script already clears its rows when there is no focused app; subscribing to
# the workspace change is what makes it get the chance to run.
sketchybar --add item front_app left \
           --set front_app drawing=off script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched \
           --subscribe front_app aerospace_workspace_change

##### Now Playing #####
# Invisible anchor polled on a timer: macOS has no event to subscribe to for
# media changes, so the plugin re-reads the track and rebuilds its rows.
# See plugins/now_playing.sh

sketchybar --add item now_playing right \
           --set now_playing drawing=off script="$PLUGIN_DIR/now_playing.sh" \
           update_freq=2

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
